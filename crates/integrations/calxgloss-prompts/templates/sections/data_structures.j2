{# The data-structure section, shared by every engine template that feeds #}
{# the recovered structures. Parameterized by (findings list, heading text, #}
{# scan coverage record) so each template passes its own heading text and #}
{# the coverage the producing scan stamped. The body is verbatim-pinned by #}
{# the section suite in src/lib.rs — wording or formatting drift fails CI. #}
{# The coverage record (issue #348) arrives as CoverageInfo strings: the #}
{# scan's status word and its admission line. The include appends exactly #}
{# one "Coverage:" qualification line beside the entries whenever the #}
{# record carries an admission; a complete or missing record renders #}
{# exactly what it rendered before. Unlike the other shared includes, the #}
{# findings decide whether the section exists at all: structures the scan #}
{# never recovered establish nothing about the function, so there is no #}
{# heading to qualify over an empty list. #}
{# The seam capability records (#357 fan-out): one admission line per #}
{# family this section feeds — the engine facets behind it, as the capability #}
{# probe answers them — quoted from the held seam report. Each rides exactly #}
{# one "Analysis engine:" line, after the coverage line, beside the entries; #}
{# when the section filed nothing at all the line rides under the heading, #}
{# the heading opening for the first line that needs it. An answerable or #}
{# undeclared family renders exactly what it rendered before. #}
{% macro data_structures_section(findings, heading, coverage, decompilation_cap, type_database_cap, data_items_cap) %}
{% if !findings.is_empty() %}
## {{ heading }}

The following data structures are used in or near this function:

{% for ds in findings %}
### {{ ds.name }}
Size: {{ ds.size }} bytes
Fields:
{% for field in ds.fields %}
- `{{ field.name }}` : {{ field.type_ }} {% if field.offset != -1 %}(offset: {{ field.offset }}){% endif %}
{% endfor %}

{% endfor %}

{% if !coverage.admission.is_empty() %}
Coverage: {{ coverage.admission }}

{% endif %}
{% endif %}
{% if !decompilation_cap.is_empty() %}
{% if findings.is_empty() %}
{% if coverage.admission.is_empty() %}
## {{ heading }}

{% endif %}
{% endif %}
Analysis engine: {{ decompilation_cap }}

{% endif %}
{% if !type_database_cap.is_empty() %}
{% if findings.is_empty() %}
{% if coverage.admission.is_empty() %}
{% if decompilation_cap.is_empty() %}
## {{ heading }}

{% endif %}
{% endif %}
{% endif %}
Analysis engine: {{ type_database_cap }}

{% endif %}
{% if !data_items_cap.is_empty() %}
{% if findings.is_empty() %}
{% if coverage.admission.is_empty() %}
{% if decompilation_cap.is_empty() %}
{% if type_database_cap.is_empty() %}
## {{ heading }}

{% endif %}
{% endif %}
{% endif %}
{% endif %}
Analysis engine: {{ data_items_cap }}

{% endif %}
{% endmacro %}
